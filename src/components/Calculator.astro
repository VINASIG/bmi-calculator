---
import { Calculator } from '@lucide/astro';
import { copy, adultLabels } from '../lib/copy.ts';
import type { Profile } from '../lib/bmi.ts';
import '../styles/tokens.css';
import '../styles/app.css';
interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const c = copy[profile];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const root = 'https://vinasig.github.io/bmi-calculator/';
const canonical = root + (profile === 'adult' ? 'en/' : '');
const adultRanges = [
  'Below 18.5',
  '18.5 to below 25',
  '25 to below 30',
  '30 to below 35',
  '35 to below 40',
  '40 or above',
];
const categories = Object.entries(adultLabels);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.title,
  url: canonical,
  description: c.description,
  inLanguage: c.lang,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: 'VINASIG',
    url: 'https://github.com/VINASIG',
  },
};
---

<!doctype html>
<html lang={c.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{c.title} | VINASIG</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${c.title} | VINASIG`} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:locale"
      content={profile === 'military' ? 'vi_VN' : 'en_US'}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/mark.svg`} />
    {[16, 32, 48].map((size) => (
      <link
        rel="icon"
        type="image/png"
        sizes={`${size}x${size}`}
        href={`${base}brand/favicon-${size}.png`}
      />
    ))}
    <link
      rel="preload"
      href={`${base}fonts/SpaceGrotesk-VariableFont_wght.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={`${base}fonts/font.css`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-profile={profile}>
    <a class="skip-link" href="#calculator">
      {c.skip}
    </a>
    <div class="app-shell">
      <header class="site-header">
        <a class="brand" href="https://github.com/VINASIG" aria-label="VINASIG">
          <img
            src={`${base}brand/primary-color.svg`}
            width="132"
            height="34"
            alt="VINASIG"
          />
        </a>
        <nav aria-label={c.navigation}>
          <a
            href={base}
            lang="vi"
            aria-current={profile === 'military' ? 'page' : undefined}
          >
            BMI NVQS
          </a>
          <a
            href={`${base}en/`}
            lang="en"
            aria-current={profile === 'adult' ? 'page' : undefined}
          >
            Adult BMI
          </a>
        </nav>
      </header>
      <main>
        <div class="intro">
          <h1>{c.title}</h1>
          <p class="lead">{c.lead}</p>
          <p>{c.intro}</p>
        </div>
        <div class="workspace" id="calculator">
          <section class="editor" aria-labelledby="form-heading">
            <h2 id="form-heading">{c.formTitle}</h2>
            <form id="bmi-form" novalidate autocomplete="off">
              <div class="fields">
                <div class="field">
                  <label for="height">{c.height}</label>
                  <input
                    id="height"
                    type="text"
                    inputmode="decimal"
                    maxlength="12"
                    placeholder="170"
                    required
                    aria-describedby="measurement-hint height-error"
                  />
                  <p class="field-error" id="height-error" hidden></p>
                </div>
                <div class="field">
                  <label for="weight">{c.weight}</label>
                  <input
                    id="weight"
                    type="text"
                    inputmode="decimal"
                    maxlength="12"
                    placeholder={profile === 'military' ? '65,5' : '65.5'}
                    required
                    aria-describedby="measurement-hint weight-error"
                  />
                  <p class="field-error" id="weight-error" hidden></p>
                </div>
              </div>
              <p class="supporting" id="measurement-hint">
                {c.hint}
              </p>
              <div class="form-actions">
                <button type="submit" id="calculate" class="primary" disabled>
                  {c.calculate}
                </button>
                <button type="reset" class="quiet">
                  {c.clear}
                </button>
              </div>
              <p class="supporting privacy">{c.privacy}</p>
              <p
                class="status supporting"
                id="status"
                role="status"
                aria-live="polite"
              ></p>
              <noscript>
                <p>{c.noScript}</p>
              </noscript>
            </form>
          </section>
          <section class="preview" aria-labelledby="result-heading">
            <h2 id="result-heading" tabindex="-1">
              {c.resultTitle}
            </h2>
            <div id="empty-result" class="empty-result">
              <Calculator size={32} aria-hidden="true" />
              <p>{c.empty}</p>
            </div>
            <div id="result" hidden>
              <p class="bmi-value">
                <span id="bmi-value"></span>
                <span class="bmi-unit">kg/m²</span>
              </p>
              <p class="category" id="category"></p>
              <p class="supporting" id="calculation"></p>
              <p class="supporting">{c.resultNote}</p>
            </div>
            <p class="result-scope">{c.scope}</p>
          </section>
        </div>
        <div class="notes">
          <details>
            <summary>{c.details}</summary>
            <p>{c.formula}</p>
            {profile === 'military' ? (
              <>
                <p>{c.legalDetails}</p>
                <ul class="ranges">
                  <li>
                    <span>Dưới 18,0</span>
                    <span>Dưới ngưỡng BMI</span>
                  </li>
                  <li>
                    <span>18,0 đến 29,9</span>
                    <span>Trong ngưỡng BMI</span>
                  </li>
                  <li>
                    <span>Trên 29,9</span>
                    <span>Trên ngưỡng BMI</span>
                  </li>
                </ul>
              </>
            ) : (
              <ul class="ranges">
                {categories.map(([key, label], i) => (
                  <li data-band={key}>
                    <span>{adultRanges[i]}</span>
                    <span>{label}</span>
                  </li>
                ))}
              </ul>
            )}
            <p>
              <a href={c.source}>{c.sourceName}</a>
            </p>
            <p class="supporting">{c.reviewed}</p>
          </details>
          <details>
            <summary>{c.scopeQuestion}</summary>
            <p>{c.scope}</p>
            {profile === 'adult' && (
              <>
                <p>
                  <a href="https://www.cdc.gov/bmi/about/index.html">
                    About BMI at CDC
                  </a>
                </p>
                <p>
                  <a href="https://www.nhs.uk/health-assessment-tools/calculate-your-body-mass-index/calculate-bmi-for-adults">
                    NHS guidance on when to avoid an adult BMI tool
                  </a>
                </p>
              </>
            )}
          </details>
          <details>
            <summary>{c.privacyQuestion}</summary>
            <p>{c.privacyDetails}</p>
          </details>
        </div>
      </main>
      <footer class="site-footer">
        <p>{c.footer}</p>
        <a href="https://github.com/VINASIG/bmi-calculator">{c.sourceLink}</a>
      </footer>
    </div>
    <script>
      import '../scripts/calculator.ts';
    </script>
  </body>
</html>
