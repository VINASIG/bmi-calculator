---
import { Calculator } from '@lucide/astro';
import {
  copy,
  labels,
  medicalSource,
  gainSource,
  ranges,
} from '../lib/adult-copy.ts';
import type { Locale } from '../lib/math.ts';
import '../styles/tokens.css';
import '../styles/app.css';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const c = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const root = 'https://bmi.vinasig.io.vn/';
const canonical = root + (lang === 'en' ? 'en/' : '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: c.title,
  url: canonical,
  description: c.description,
  inLanguage: lang,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: 'VINASIG',
    url: 'https://github.com/VINASIG',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{c.title} | VINASIG</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={root} />
    <link rel="alternate" hreflang="en" href={`${root}en/`} />
    <link rel="alternate" hreflang="x-default" href={root} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${c.title} | VINASIG`} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href={`${base}brand/mark.svg`} />
    {[16, 32, 48].map((size) => (
      <link
        rel="icon"
        type="image/png"
        sizes={`${size}x${size}`}
        href={`${base}brand/favicon-${size}.png`}
      />
    ))}
    <link
      rel="preload"
      href={`${base}fonts/SpaceGrotesk-VariableFont_wght.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href={`${base}fonts/font.css`} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-tool="adult" data-language={lang}>
    <a class="skip-link" href="#calculator">
      {c.skip}
    </a>
    <div class="app-shell">
      <header class="site-header">
        <a
          class="brand"
          href="https://github.com/VINASIG"
          aria-label="VINASIG"
          data-brand-logo
        >
          <picture>
            <source
              media="(prefers-color-scheme: dark)"
              srcset={`${base}brand/reversed.svg`}
            />
            <img
              src={`${base}brand/primary-color.svg`}
              width="540"
              height="140"
              alt="VINASIG"
            />
          </picture>
        </a>
        <nav aria-label={c.navigation}>
          <a
            href={base}
            lang="vi"
            aria-current={lang === 'vi' ? 'page' : undefined}
          >
            Tiếng Việt
          </a>
          <a
            href={`${base}en/`}
            lang="en"
            aria-current={lang === 'en' ? 'page' : undefined}
          >
            English
          </a>
        </nav>
      </header>
      <main>
        <div class="intro">
          <h1>{c.title}</h1>
          <p class="lead">{c.lead}</p>
          <p>{c.intro}</p>
        </div>
        <div class="workspace" id="calculator">
          <section class="editor" aria-labelledby="form-heading">
            <h2 id="form-heading">{c.formTitle}</h2>
            <form id="bmi-form" novalidate autocomplete="off">
              <div class="fields">
                <div class="field">
                  <label for="height">{c.height}</label>
                  <input
                    id="height"
                    type="text"
                    inputmode="decimal"
                    maxlength="12"
                    placeholder="170"
                    required
                    aria-describedby="measurement-hint height-error"
                  />
                  <p class="field-error" id="height-error" hidden></p>
                </div>
                <div class="field">
                  <label for="weight">{c.weight}</label>
                  <input
                    id="weight"
                    type="text"
                    inputmode="decimal"
                    maxlength="12"
                    placeholder={lang === 'vi' ? '65,5' : '65.5'}
                    required
                    aria-describedby="measurement-hint weight-error"
                  />
                  <p class="field-error" id="weight-error" hidden></p>
                </div>
              </div>
              <p class="supporting" id="measurement-hint">
                {c.hint}
              </p>
              <div class="form-actions">
                <button type="submit" id="calculate" class="primary" disabled>
                  {c.calculate}
                </button>
                <button type="reset" class="quiet">
                  {c.clear}
                </button>
              </div>
              <p class="supporting privacy">{c.privacy}</p>
              <p
                class="status supporting"
                id="status"
                role="status"
                aria-live="polite"
              ></p>
              <noscript>
                <p>{c.noScript}</p>
              </noscript>
            </form>
          </section>
          <section class="preview" aria-labelledby="result-heading">
            <h2 id="result-heading" tabindex="-1">
              {c.resultTitle}
            </h2>
            <div id="empty-result" class="empty-result">
              <Calculator size={32} aria-hidden="true" />
              <p>{c.empty}</p>
            </div>
            <div id="result" hidden>
              <p class="bmi-value">
                <span id="bmi-value"></span>
                <span class="bmi-unit">kg/m²</span>
              </p>
              <p class="category" id="category"></p>
              <p class="supporting" id="calculation"></p>
              <p class="supporting">{c.resultNote}</p>
              <p class="supporting">
                {c.exact} <span id="exact-bmi"></span>
              </p>
            </div>
            <p class="result-scope">{c.scope}</p>
          </section>
          <div id="result-details" class="workspace-addendum" hidden>
            <section class="result-section" aria-labelledby="advice-heading">
              <h3 id="advice-heading">{c.adviceTitle}</h3>
              <p>
                {c.reference} <strong id="weight-range"></strong>
              </p>
              <p class="supporting">{c.referenceNote}</p>
              <p id="weight-distance"></p>
              <p id="weight-change"></p>
              <p id="health-advice"></p>
              <p class="supporting">{c.adviceDisclaimer}</p>
            </section>
          </div>
        </div>
        <div class="notes">
          <details>
            <summary>{c.details}</summary>
            <p>{c.formula}</p>
            <ul class="ranges">
              {Object.entries(labels[lang]).map(([key, label], index) => (
                <li data-band={key}>
                  <span>{ranges[lang][index]}</span>
                  <span>{label}</span>
                </li>
              ))}
            </ul>
            <p>
              <a href={medicalSource}>{c.sourceName}</a>
            </p>
            <p class="supporting">{c.reviewed}</p>
          </details>
          <details>
            <summary>{c.scopeQuestion}</summary>
            <p>{c.scope}</p>
            <p>{c.underAdvice}</p>
            <p>{c.overAdvice}</p>
            <p>{c.adviceDisclaimer}</p>
            <p>
              <a href={gainSource}>{c.adviceSource}</a>
            </p>
          </details>
          <details>
            <summary>{c.privacyQuestion}</summary>
            <p>{c.privacyDetails}</p>
          </details>
        </div>
        <section class="tool-choice" aria-labelledby="choice-heading">
          <h2 id="choice-heading">{c.chooseTitle}</h2>
          <p>{c.chooseAdult}</p>
          <p>{c.chooseMilitary}</p>
          <a
            id="other-tool"
            href={`https://nvqs-bmi.vinasig.io.vn/${lang === 'en' ? 'en/' : ''}`}
          >
            {c.otherLink}
          </a>
        </section>
      </main>
      <footer class="site-footer">
        <p>{c.footer}</p>
        <a href="https://github.com/VINASIG/bmi-calculator">{c.sourceLink}</a>
      </footer>
    </div>
    <script>
      import '../scripts/adult-calculator.ts';
    </script>
  </body>
</html>
